"use strict";
var table = document.querySelector("table");
var headers = table.querySelectorAll("th");
var tbody = table.querySelector("tbody");
// оновлення рядків
function updateRows() {
    var allRows = tbody.querySelectorAll("tr");
    allRows.forEach(function(rowTr) {
        rowTr.addEventListener("click", function() {
            allRows.forEach(function(r) {
                r.classList.remove("active");
            });
            rowTr.classList.add("active");
        });
    });
}
updateRows();
// спрацьовує: Тільки один раз при завантаженні сторінки.
headers.forEach(function(th, index) {
    th.setAttribute("data-order", "desc");
    th.addEventListener("click", function() {
        sortByColumn(index, th);
    });
});
// сортування колонок
function sortByColumn(columnIndex, headerElement) {
    var currentOrder = headerElement.getAttribute("data-order");
    // Скидання інших колонок (Логіка перемикання)
    headers.forEach(function(th) {
        if (th !== headerElement) th.setAttribute("data-order", "desc");
    });
    var newOrder = currentOrder === "desc" ? "asc" : "desc";
    var sortedRow = Array.from(tbody.querySelectorAll("tr")).sort(function(rowA, rowB) {
        var cellA = rowA.children[columnIndex];
        var cellB = rowB.children[columnIndex];
        var textA = cellA.textContent.trim();
        var textB = cellB.textContent.trim();
        var isNum = columnIndex === 3 || columnIndex === 4;
        var valA = isNum ? parseFloat(textA.replace("$", "").replace(",", "")) : textA;
        var valB = isNum ? parseFloat(textB.replace("$", "").replace(",", "")) : textB;
        var comparator = 0;
        if (isNum) comparator = valA - valB;
        else comparator = valA.toLowerCase().localeCompare(valB.toLowerCase());
        return newOrder === "asc" ? comparator : comparator * -1;
    });
    // Оновлення DOM //
    sortedRow.forEach(function(row) {
        tbody.appendChild(row);
    });
    headerElement.setAttribute("data-order", newOrder);
}
